rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'azzackey@gmail.com' ||
        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Categories: Public read, Authenticated / Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Books: Public read, Catalog management
    match /books/{bookId} {
      allow read: if true;
      allow write: if true;
    }

    // Shelves: Public read, Shelf management
    match /shelves/{shelfId} {
      allow read: if true;
      allow write: if true;
    }

    // Members: Profile and member management
    match /members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings: 24h hold bookings
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

    // Loans: Circulation & returns
    match /loans/{loanId} {
      allow read: if true;
      allow write: if true;
    }

    // Notifications: System reminders
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // System configuration (Suspend settings, limits)
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Test Connection collection for health checks
    match /test/{testDoc} {
      allow read, write: if true;
    }
  }
}

